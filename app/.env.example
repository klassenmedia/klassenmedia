DATABASE_URL="file:./dev.db"
# 64 Hex-Zeichen, z.B. via: openssl rand -hex 32
APP_SECRET="bitte-eigenen-zufallswert-eintragen"

# Upload-Verzeichnis — leer lassen (Standard: ./uploads). In der Cloud auf ein
# persistentes Volume zeigen lassen, z.B. UPLOADS_DIR="/data/uploads"
# UPLOADS_DIR="./uploads"

# Stripe — leer lassen fuer Demo-Modus ohne Zahlung.
# Echte Zahlungen in 3 Schritten (KEINE Produkte/Preise bei Stripe anlegen —
# der Preis fuer "Planbar Komplett" liegt serverseitig im Code):
#   1. Stripe-Konto: dashboard.stripe.com → Entwickler → API-Schluessel
#      → "Geheimschluessel" kopieren → STRIPE_SECRET_KEY
#   2. Entwickler → Webhooks → Endpoint hinzufuegen:
#      https://<deine-domain>/api/stripe/webhook
#      Events: checkout.session.completed, customer.subscription.updated,
#      customer.subscription.deleted, invoice.paid
#      → "Signaturgeheimnis" kopieren → STRIPE_WEBHOOK_SECRET
#   3. Einstellungen → Billing → Kundenportal einmal aktivieren
#      (fuer "Zahlungsmethode aendern / kuendigen" in der App)
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Publishing (Phase 2b) — "live" schaltet echte Plattform-Adapter frei
# PUBLISH_MODE="simulate"

# Echte KI (Phase 4) — Plattform-Keys fuer den "credits"-Modus.
# Leer lassen = Demo-Modus (Platzhalter, keine Credits). Kunden im BYO-Modus
# hinterlegen ihre eigenen Keys im KI-Studio (verschluesselt gespeichert).
# ANTHROPIC_API_KEY="sk-ant-..."   # Texte (Claude)
# OPENAI_API_KEY="sk-..."          # Bilder (gpt-image-1)
