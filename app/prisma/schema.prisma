// Phase-1-Schema: läuft lokal mit SQLite (keine Installation nötig).
// Für den Cloud-Umzug wird nur provider = "postgresql" gesetzt und die
// String-Status-Felder werden wieder zu echten Enums (SQLite kann keine Enums).
// Gültige Werte stehen als Kommentar an jedem Feld — die Validierung passiert
// zusätzlich in den Server Actions (zod).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Nutzer, Sessions & Mandanten ──────────────────────────────────────

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  name         String
  passwordHash String
  createdAt    DateTime          @default(now())
  memberships  WorkspaceMember[]
  sessions     Session[]
}

// Serverseitige Sessions: im Cookie liegt nur ein Zufallstoken,
// in der DB nur dessen SHA-256-Hash (Diebstahl der DB ≠ gültige Sessions)
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Workspace {
  id                 String              @id @default(cuid())
  name               String
  createdAt          DateTime            @default(now())
  members            WorkspaceMember[]
  socialAccounts     SocialAccount[]
  connectionInvites  ConnectionInvite[]
  posts              Post[]
  mediaAssets        MediaAsset[]
  aiMode             String              @default("credits") // credits | byo
  // BYO-Keys werden NIE im Klartext gespeichert (AES-256-GCM, Schlüssel in ENV)
  anthropicKeyEnc    String?
  openaiKeyEnc       String?
  plan               String              @default("starter") // starter | pro | agency
  creditBalance      Int                 @default(0)
  creditTransactions CreditTransaction[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  role        String    @default("owner") // owner | admin | editor | viewer

  @@unique([workspaceId, userId])
}

// ── Social Accounts & Kunden-Verbindungslinks ─────────────────────────

model SocialAccount {
  id          String    @id @default(cuid())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  platform    String // instagram | facebook | tiktok | linkedin | youtube | x | pinterest
  displayName String
  handle      String
  // OAuth-Tokens (Phase 2): verschlüsselt, nie Klartext
  accessTokenEnc  String?
  refreshTokenEnc String?
  status      String    @default("connected") // connected | token_expired | revoked
  connectedAt DateTime  @default(now())
  postLinks   PostAccount[]

  @@index([workspaceId])
}

model ConnectionInvite {
  id          String    @id @default(cuid())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  token       String    @unique
  platform    String
  clientName  String
  status      String    @default("pending") // pending | accepted | expired | revoked
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?

  @@index([workspaceId, status])
}

// ── Inhalte & Planung ─────────────────────────────────────────────────

model Post {
  id          String        @id @default(cuid())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  body        String
  format      String        @default("image") // text | image | video | carousel | story
  scheduledAt DateTime
  status      String        @default("scheduled") // draft | scheduled | published | failed
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  accounts    PostAccount[]
  media       MediaAsset[]
  comments    Comment[]

  @@index([workspaceId, scheduledAt])
  @@index([status, scheduledAt]) // Scheduler-Query (Phase 2): fällige Posts
}

// Verknüpfung Post ↔ SocialAccount (Phase 2 ergänzt bodyOverride, publishedPostId, error)
model PostAccount {
  id        String        @id @default(cuid())
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  account   SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String

  @@unique([postId, accountId])
}

model MediaAsset {
  id          String    @id @default(cuid())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  // echte Uploads: /uploads/<datei>; Demo-/KI-Platzhalter: placeholder:<hue>
  url         String
  kind        String    @default("image") // image | video
  source      String    @default("upload") // upload | ai | placeholder
  createdAt   DateTime  @default(now())
  post        Post?     @relation(fields: [postId], references: [id], onDelete: SetNull)
  postId      String?
  sortOrder   Int       @default(0)

  @@index([workspaceId])
}

// ── Kommentare (Inbox) ────────────────────────────────────────────────
// Phase 1: lokale Verwaltung mit Demo-Daten. Phase 2 synchronisiert echte
// Kommentare über die Plattform-APIs (Meta/TikTok/LinkedIn) — liken,
// antworten und löschen laufen dann über dieselben Actions.

model Comment {
  id          String    @id @default(cuid())
  workspaceId String
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      String
  author      String // Anzeigename des Kommentators
  authorHandle String?
  text        String
  likedByUs   Boolean   @default(false)
  isOwnReply  Boolean   @default(false) // von uns über das Tool geantwortet
  parent      Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId    String?
  replies     Comment[] @relation("Replies")
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([postId])
}

// ── Credits ───────────────────────────────────────────────────────────

model CreditTransaction {
  id          String    @id @default(cuid())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  type        String // purchase | plan_grant | usage_text | usage_image | adjustment
  amount      Int // positiv = Gutschrift, negativ = Verbrauch
  description String
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}
